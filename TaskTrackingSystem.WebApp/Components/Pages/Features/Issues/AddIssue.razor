    private void RequestSaveConfirmation()
    {
        isTaskError = false;
        isTitleError = false;
        taskErrorMessage = "";
        titleErrorMessage = "";

        if (formTaskId <= 0)
        {
            isTaskError = true;
            taskErrorMessage = AppLocalization.Text("validation.selectTaskRequired", "Please select a task.");
            return;
        }

        if (string.IsNullOrWhiteSpace(formTitle) && string.IsNullOrWhiteSpace(formTitleMy))
        {
            isTitleError = true;
            titleErrorMessage = AppLocalization.Text("validation.issueTitleRequired", "Issue title is required.");
            return;
        }

        if (formDueDate.Date < formStartDate.Date)
        {
            errorMessage = AppLocalization.Text("issue.dateRangeInvalid", "The due date cannot be earlier than the start date.");
            return;
        }

        showConfirmDialog = true;
    }

    private void CloseConfirmDialog()
    {
        showConfirmDialog = false;
    }

    private async Task ConfirmSave()
    {
        showConfirmDialog = false;
        await SaveIssueAsync();
    }

    private async Task SaveIssueAsync()
    {
        if (isSaving)
        {
            return;
        }

        if (formTaskId <= 0)
        {
            errorMessage = AppLocalization.Text("validation.selectTaskRequired", "Please select a task.");
            return;
        }

        if (string.IsNullOrWhiteSpace(formTitle) && string.IsNullOrWhiteSpace(formTitleMy))
        {
            errorMessage = AppLocalization.Text("validation.issueTitleRequired", "Issue title is required.");
            return;
        }

        if (formDueDate.Date < formStartDate.Date)
        {
            errorMessage = AppLocalization.Text("issue.dateRangeInvalid", "The due date cannot be earlier than the start date.");
            return;
        }

        isSaving = true;
        errorMessage = null;

        try
        {
            var client = ApiClient.CreateClient();
            var dto = new CreateIssueDto
            {
                TaskId = formTaskId,
                Title = formTitle.Trim(),
                TitleMy = formTitleMy,
                Description = formDescription,
                DescriptionMy = formDescriptionMy,
                AssignedTo = formAssignedTo,
                EstimatedHours = formEstimatedHours,
                ActualHours = formActualHours,
                DelayReason = formDelayReason,
                DelayReasonMy = formDelayReasonMy,
                IsBlocked = formIsBlocked,
                BlockedBy = formBlockedBy,
                BlockedByMy = formBlockedByMy,
                EscalationLevel = formEscalationLevel,
                StartDate = formStartDate,
                DueDate = formDueDate,
                StatusId = formStatusId,
                PriorityId = formPriorityId
            };

            var response = await client.PostAsJsonAsync("Issue", dto);
            var result = await response.Content.ReadFromJsonAsync<Result<IssueDto>>(Serialization.CaseInsensitive);

            if (response.IsSuccessStatusCode && result?.IsSuccess == true)
            {
                Navigation.NavigateTo("/issues/all?created=true");
            }
            else
            {
                errorMessage = AppLocalization.Text("issue.failedCreate", "Failed to create issue. Please try again.");
                Console.WriteLine($"Create issue rejected: {result?.ErrorMessage ?? response.ReasonPhrase}");
            }
        }
        catch (Exception ex)
        {
            errorMessage = AppLocalization.Text("issue.failedCreate", "Failed to create issue. Please try again.");
            Console.WriteLine($"Create issue error: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ResetForm()
    {
        formTaskId = tasks.FirstOrDefault()?.Id ?? 0;
        formTitle = "";
        formTitleMy = null;
        formDescription = null;
        formDescriptionMy = null;
        burmeseGenerated = englishGenerated = burmeseNeedsReview = englishNeedsReview = false;
        formAssignedTo = currentUserId;
        formEstimatedHours = null;
        formActualHours = 7m;
        formStartDate = DateTime.Today;
        formDueDate = DateTime.Today;
        formStatusId = AppTaskStatus.Todo;
        formPriorityId = TaskPriority.Medium;
        formDelayReason = null;
        formDelayReasonMy = null;
        formIsBlocked = false;
        formBlockedBy = null;
        formBlockedByMy = null;
        formEscalationLevel = 0;
        taskErrorMessage = "";
        titleErrorMessage = "";
        isTaskError = false;
        isTitleError = false;
        assigneeSearchInput = "";
        isAssigneeDropdownOpen = false;
        _ = LoadProjectMembersForTaskAsync(formTaskId);
    }
