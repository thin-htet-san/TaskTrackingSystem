<ReportChartCard Title="@Title" Subtitle="@Subtitle" Insight="@Insight">
    @if (!Points.Any())
    {
        <div class="rounded-lg border border-dashed border-slate-200 bg-slate-50 py-10 text-center text-sm text-slate-400">@EmptyText</div>
    }
    else
    {
        <div class="space-y-3">
            <div class="grid grid-cols-[72px_repeat(3,minmax(0,1fr))] items-center gap-2">
                <div></div>
                @foreach (var label in UrgencyLabels)
                {
                    <div class="rounded-lg bg-slate-50 px-2 py-1.5 text-center text-[11px] font-semibold uppercase tracking-wider text-slate-500">@label</div>
                }
            </div>

            <div class="grid grid-cols-[72px_minmax(0,1fr)] gap-2">
                <div class="flex items-center justify-center rounded-lg bg-slate-50 px-2 text-center text-[11px] font-semibold uppercase tracking-wider text-slate-500 [writing-mode:vertical-rl] rotate-180">
                    @SeverityAxisLabel
                </div>
                <div class="grid min-h-[260px] grid-cols-3 grid-rows-3 gap-2 rounded-xl border border-slate-100 bg-slate-50 p-2" role="img" aria-label="@Title">
            @for (var y = 3; y >= 1; y--)
            {
                @for (var x = 1; x <= 3; x++)
                {
                    var points = Points.Where(point => point.Severity == x && point.Urgency == y).ToList();
                    var total = points.Sum(point => point.Value);
                            var title = BuildCellTitle(points, x, y, total);
                    <div class="@GetCellClass(x, y, total)" title="@title">
                        <span class="@GetCountClass(total)">@AppLocalization.Number(total, "0")</span>
                        <span class="@GetLabelClass(total)">@GetCellLabel(x, y, total)</span>
                        @if (total > 0)
                        {
                            <span class="mt-1 truncate text-[11px] text-slate-500">@BuildCellSummary(points)</span>
                        }
                    </div>
                }
            }
                </div>
            </div>

            <div class="grid grid-cols-[72px_repeat(3,minmax(0,1fr))] items-center gap-2">
                <div></div>
                @foreach (var label in SeverityLabels)
                {
                    <div class="text-center text-[11px] font-medium text-slate-400">@label</div>
                }
            </div>

            <div class="flex flex-wrap items-center gap-x-4 gap-y-2 rounded-lg border border-slate-100 bg-slate-50 px-3 py-2 text-[11px] text-slate-500 font-sans">
                <span class="font-semibold uppercase tracking-wider text-slate-400">@AppLocalization.Text("report.legend", "Legend")</span>
                <span class="flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-emerald-400"></span>@AppLocalization.Text("report.healthGood", "Healthy")</span>
                <span class="flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-blue-400"></span>@AppLocalization.Text("report.healthWatch", "Watch")</span>
                <span class="flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-amber-400"></span>@AppLocalization.Text("report.healthAtRisk", "At risk")</span>
                <span class="flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-rose-400"></span>@AppLocalization.Text("report.healthCritical", "Critical")</span>
            </div>
        </div>
    }
</ReportChartCard>

@code {
    [Parameter] public string Title { get; set; } = AppLocalization.Text("report.riskMatrix", "Risk matrix");
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Insight { get; set; }
    [Parameter] public IReadOnlyList<RiskMatrixPoint> Points { get; set; } = Array.Empty<RiskMatrixPoint>();
    [Parameter] public string EmptyText { get; set; } = AppLocalization.Text("report.noMatrixData", "No matrix data available.");
    [Parameter] public string SeverityAxisLabel { get; set; } = AppLocalization.Text("report.riskSeverity", "Risk severity");
    [Parameter] public IReadOnlyList<string> UrgencyLabels { get; set; } = new[] { AppLocalization.Text("report.lowUrgency", "Low urgency"), AppLocalization.Text("report.medium", "Medium"), AppLocalization.Text("report.highUrgency", "High urgency") };
    [Parameter] public IReadOnlyList<string> SeverityLabels { get; set; } = new[] { AppLocalization.Text("report.lowRisk", "Low risk"), AppLocalization.Text("report.medium", "Medium"), AppLocalization.Text("report.highRisk", "High risk") };

    private static string GetCellLabel(int severity, int urgency, double total)
    {
        if (total <= 0)
        {
            return AppLocalization.Text("report.noProjects", "No projects");
        }

        return (severity, urgency) switch
        {
            (3, 3) => AppLocalization.Text("report.healthCritical", "Critical"),
            (3, _) or (_, 3) => AppLocalization.Text("report.healthAtRisk", "At risk"),
            (1, 1) => AppLocalization.Text("report.healthGood", "Healthy"),
            _ => AppLocalization.Text("report.healthWatch", "Watch")
        };
    }

    private static string GetCellClass(int severity, int urgency, double total)
    {
        if (total <= 0)
        {
            return "flex min-h-[72px] flex-col justify-center rounded-lg border border-slate-100 bg-white p-3 text-center transition-colors hover:border-slate-200";
        }

        var score = severity * urgency;
        var tone = score >= 9
            ? "border-rose-200 bg-rose-50"
            : score >= 6
                ? "border-amber-200 bg-amber-50"
                : score >= 3
                    ? "border-blue-100 bg-blue-50"
                    : "border-emerald-100 bg-emerald-50";

        return $"flex min-h-[72px] flex-col justify-center rounded-lg border p-3 text-center transition-colors hover:border-slate-300 hover:bg-white {tone}";
    }

    private static string GetCountClass(double total) => total > 0
        ? "text-2xl font-bold tabular-nums text-slate-950"
        : "text-xl font-bold tabular-nums text-slate-300";

    private static string GetLabelClass(double total) => total > 0
        ? "mt-1 text-[11px] font-semibold uppercase tracking-wider text-slate-600"
        : "mt-1 text-[11px] font-medium text-slate-400";

    private static string BuildCellSummary(IReadOnlyList<RiskMatrixPoint> points)
    {
        return string.Join(", ", points.OrderByDescending(point => point.Value).Take(2).Select(point => point.Label));
    }

    private static string BuildCellTitle(IReadOnlyList<RiskMatrixPoint> points, int severity, int urgency, double total)
    {
        if (total <= 0)
        {
            return $"{AppLocalization.Text("report.noProjects", "No projects")}. {AppLocalization.Text("report.riskSeverity", "Severity")} {AppLocalization.Number(severity)}, {AppLocalization.Text("report.urgencyLabel", "urgency")} {AppLocalization.Number(urgency)}.";
        }

        var names = string.Join(Environment.NewLine, points.OrderByDescending(point => point.Value).Select(point => $"{point.Label}: {point.Detail ?? $"{AppLocalization.Number(point.Value)} {AppLocalization.Text("report.itemsCount", "item(s)")}"}"));
        return $"{AppLocalization.Number(total)} {AppLocalization.Text("report.projectsCount", "project(s)")}{Environment.NewLine}{names}";
    }
}
