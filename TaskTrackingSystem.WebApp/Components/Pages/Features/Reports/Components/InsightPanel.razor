<div class="@PanelClass">
    <h3 class="text-sm font-semibold text-slate-900">@Title</h3>
    <div class="mt-3 grid grid-cols-1 gap-3 md:grid-cols-3">
        @foreach (var insight in Insights)
        {
            <div class="rounded-lg bg-slate-50 px-3 py-2 text-sm text-slate-700">@insight</div>
        }
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = AppLocalization.Text("report.keyInsights", "Key Insights");
    [Parameter] public IReadOnlyList<string> Insights { get; set; } = Array.Empty<string>();
    [Parameter] public string PanelClass { get; set; } = "rounded-xl border border-slate-200 bg-white p-5 shadow-sm";
}
