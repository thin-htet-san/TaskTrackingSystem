@page "/"
@page "/Home"
@page "/dashboard"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using TaskTrackingSystem.Shared.Models.Task
@using TaskTrackingSystem.Shared.Models.User
@using TaskTrackingSystem.Shared.Models.Project
@using TaskTrackingSystem.Shared.Models.Dashboard
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ApiClientService ApiClient
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Dashboard</PageTitle>

@if (isLoading)
{
    <div class="flex items-center justify-center py-40">
        <div class="flex flex-col items-center space-y-4 text-violet-600">
            <svg class="animate-spin h-10 w-10" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
            <span class="text-sm font-semibold text-slate-500">Loading TaskFlow Dashboard...</span>
        </div>
    </div>
}
else
{
    <div class="space-y-8">
        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
            <div>
                <p class="text-sm font-semibold text-violet-600 uppercase tracking-wider">Dashboard</p>
                <h2 class="text-3xl font-bold tracking-tight text-slate-900 mt-1">Welcome back, @currentUserName</h2>
                <p class="text-slate-500 mt-1">Here's what's happening across your workspace today.</p>
            </div>
            <div class="flex gap-3">
                <a href="/tasks" class="inline-flex items-center rounded-xl bg-violet-600 text-white px-4 py-2.5 text-sm font-semibold hover:bg-violet-700 transition-colors shadow-sm">
                    <i data-lucide="plus" class="h-4 w-4 mr-2"></i> New Task
                </a>
                <a href="/reports/tasks" class="inline-flex items-center rounded-xl bg-violet-600 text-white px-4 py-2.5 text-sm font-semibold hover:bg-violet-700 transition-colors shadow-sm">
                    <i data-lucide="bar-chart-3" class="h-4 w-4 mr-2"></i> Reports
                </a>
            </div>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-semibold text-slate-400 uppercase">Total Tasks</span>
                    <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-violet-50 text-violet-600"><i data-lucide="list-todo" class="h-4 w-4"></i></span>
                </div>
                <p class="text-3xl font-bold text-slate-900 mt-3">@TotalTasksCount</p>
            </div>
            <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-semibold text-slate-400 uppercase">Completed</span>
                    <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600"><i data-lucide="check-circle" class="h-4 w-4"></i></span>
                </div>
                <p class="text-3xl font-bold text-emerald-600 mt-3">@CompletedTasksCount</p>
            </div>
            <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-semibold text-slate-400 uppercase">In Progress</span>
                    <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-50 text-blue-600"><i data-lucide="loader" class="h-4 w-4"></i></span>
                </div>
                <p class="text-3xl font-bold text-blue-600 mt-3">@(taskStatuses.FirstOrDefault(s => s.StatusId == 2)?.TaskCount ?? 0)</p>
            </div>
            <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-semibold text-slate-400 uppercase">Overdue</span>
                    <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-rose-50 text-rose-600"><i data-lucide="alert-triangle" class="h-4 w-4"></i></span>
                </div>
                <p class="text-3xl font-bold text-rose-600 mt-3">@OverdueTasksCount</p>
            </div>
        </div>

        <div class="grid grid-cols-1 xl:grid-cols-12 gap-6">
            <div class="xl:col-span-8 space-y-6">
                <div class="rounded-2xl border border-slate-100 bg-white shadow-sm overflow-hidden">
                    <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100 bg-slate-50/50">
                        <h3 class="font-bold text-slate-800">In Progress Tasks</h3>
                        <a href="/tasks" class="text-xs font-semibold text-violet-600 hover:text-violet-800">View all</a>
                    </div>
                    <div class="p-6">
                        @if (ActiveTasks.Any())
                        {
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                @foreach (var task in ActiveTasks)
                                {
                                    var proj = projectsList.FirstOrDefault(p => p.Id == task.ProjectId);
                                    var daysLeft = (task.DueDate - DateTime.Today).Days;
                                    var progress = GetTaskProgress(task.StatusId);
                                    <div @onclick="() => NavigateToTask(task.Id)" class="rounded-xl border border-slate-100 p-4 hover:shadow-md transition-all cursor-pointer">
                                        <div class="flex items-center justify-between text-xs text-slate-400 mb-2">
                                            <span>@task.DueDate.ToString("dd-MMM-yyyy")</span>
                                            <i data-lucide="more-horizontal" class="h-4 w-4"></i>
                                        </div>
                                        <h4 class="font-bold text-sm text-slate-800 truncate">@task.Title</h4>
                                        <p class="text-xs text-violet-600 font-medium mt-1">@(proj?.Name ?? "General")</p>
                                        <div class="mt-4 space-y-1">
                                            <div class="flex justify-between text-xs">
                                                <span class="text-slate-400">Progress</span>
                                                <span class="font-semibold text-slate-700">@progress%</span>
                                            </div>
                                            <div class="h-2 rounded-full bg-slate-100 overflow-hidden">
                                                <div class="h-full rounded-full bg-emerald-500 transition-all" style="width: @(progress)%"></div>
                                            </div>
                                        </div>
                                        <span class="inline-block mt-3 rounded-full px-2 py-0.5 text-[10px] font-semibold @(daysLeft < 0 ? "bg-rose-50 text-rose-600" : daysLeft < 3 ? "bg-amber-50 text-amber-600" : "bg-emerald-50 text-emerald-600")">
                                            @(daysLeft > 0 ? $"{daysLeft} days left" : daysLeft == 0 ? "Due today" : $"{Math.Abs(daysLeft)} days overdue")
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-sm text-slate-400 text-center py-8">No tasks in progress. Great job!</p>
                        }
                    </div>
                </div>

                <div class="rounded-2xl border border-slate-100 bg-white shadow-sm overflow-hidden">
                    <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100 bg-slate-50/50">
                        <h3 class="font-bold text-slate-800">Project Progress</h3>
                        <a href="/projects" class="text-xs font-semibold text-violet-600 hover:text-violet-800">View all</a>
                    </div>
                    <div class="p-6 space-y-4">
                        @if (projectProgress.Any())
                        {
                            @foreach (var pp in projectProgress.Take(4))
                            {
                                <div @onclick="() => NavigateToProjectBoard(pp.ProjectId)" class="cursor-pointer hover:bg-slate-50/50 rounded-xl p-3 -mx-3 transition-colors">
                                    <div class="flex justify-between text-sm mb-2">
                                        <span class="font-semibold text-slate-800">@pp.ProjectName</span>
                                        <span class="text-slate-500">@pp.CompletedTasksCount / @pp.TotalTasksCount</span>
                                    </div>
                                    <div class="h-2.5 rounded-full bg-slate-100 overflow-hidden">
                                        <div class="h-full rounded-full bg-emerald-500 transition-all" style="width: @pp.CompletionPercentage%"></div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-sm text-slate-400 text-center py-4">No project data available.</p>
                        }
                    </div>
                </div>

                <div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
                    <div class="flex items-center justify-between mb-6">
                        <h3 class="font-bold text-slate-800">Weekly Activity</h3>
                        <span class="text-xs text-slate-400">Tasks completed this week</span>
                    </div>
                    <div class="flex items-end justify-between h-40 px-2 gap-2">
                        @foreach (var chartBar in GetChartBars())
                        {
                            <div class="flex flex-col items-center space-y-2 flex-1">
                                <div class="w-full max-w-[24px] rounded-t-lg bg-slate-100 h-32 flex items-end">
                                    <div class="w-full rounded-t-lg bg-emerald-500 transition-all duration-700" style="height: @(chartBar.Height)%"></div>
                                </div>
                                <span class="text-[10px] font-medium text-slate-400 uppercase">@chartBar.Day</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="xl:col-span-4 space-y-6">
                <div class="rounded-2xl border border-slate-100 bg-gradient-to-br from-violet-600 to-violet-800 p-6 text-white shadow-lg">
                    <div class="flex items-center gap-4">
                        <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-white/20 text-xl font-bold">
                            @(currentUserName.Length > 0 ? currentUserName[0].ToString().ToUpper() : "U")
                        </span>
                        <div>
                            <h4 class="font-bold text-lg">@currentUserName</h4>
                            <p class="text-violet-200 text-sm">@currentUserRole</p>
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-3 mt-5 pt-5 border-t border-white/20">
                        <div class="text-center">
                            <p class="text-2xl font-bold">@TaskCompletionRate%</p>
                            <p class="text-xs text-violet-200">Completion Rate</p>
                        </div>
                        <div class="text-center">
                            <p class="text-2xl font-bold">@summary.ActiveProjectsCount</p>
                            <p class="text-xs text-violet-200">Active Projects</p>
                        </div>
                    </div>
                </div>

                <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
                    <h4 class="font-bold text-sm text-slate-800 mb-4">@DateTime.Today.ToString("MMMM yyyy")</h4>
                    <div class="flex justify-between gap-1">
                        @foreach (var date in weekDates)
                        {
                            var isToday = date.Date == DateTime.Today.Date;
                            <div class="flex-1 rounded-xl py-2 text-center @(isToday ? "bg-violet-600 text-white shadow-md" : "text-slate-600")">
                                <span class="block text-[9px] uppercase font-semibold @(isToday ? "text-violet-200" : "text-slate-400")">@date.ToString("ddd")</span>
                                <span class="block text-sm font-bold mt-0.5">@date.Day</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
                    <div class="flex items-center justify-between mb-4">
                        <h4 class="font-bold text-sm text-slate-800">My Assignments</h4>
                        <span class="text-[10px] font-bold bg-emerald-50 text-emerald-600 px-2 py-0.5 rounded-full">@ChecklistCompletedCount done</span>
                    </div>
                    <div class="space-y-2 max-h-[240px] overflow-y-auto">
                        @if (ChecklistTasks.Any())
                        {
                            @foreach (var task in ChecklistTasks)
                            {
                                <div class="flex items-start gap-3 p-2 rounded-lg hover:bg-slate-50 transition-colors">
                                    <input type="checkbox" checked="@(task.StatusId == 3)" @onchange="() => ToggleTaskStatus(task)" class="h-4 w-4 rounded border-slate-300 text-emerald-600 accent-emerald-600 mt-0.5" />
                                    <div class="min-w-0 flex-1">
                                        <p class="text-xs font-semibold text-slate-800 truncate @(task.StatusId == 3 ? "line-through text-slate-400" : "")">@task.Title</p>
                                        <p class="text-[10px] text-slate-400">Due @task.DueDate.ToString("dd-MMM-yyyy")</p>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-xs text-slate-400 text-center py-6">All caught up!</p>
                        }
                    </div>
                </div>

                <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
                    <h4 class="font-bold text-sm text-slate-800 mb-4">Team Members</h4>
                    <div class="space-y-3">
                        @foreach (var user in GetTeamMembers())
                        {
                            <div class="flex items-center gap-3">
                                <span class="flex h-8 w-8 items-center justify-center rounded-full bg-violet-100 text-violet-700 text-[10px] font-bold">
                                    @(user.FirstName.Length > 0 ? user.FirstName[0].ToString().ToUpper() : "")@(user.LastName.Length > 0 ? user.LastName[0].ToString().ToUpper() : "")
                                </span>
                                <div class="min-w-0">
                                    <p class="text-xs font-bold text-slate-800 truncate">@user.FirstName @user.LastName</p>
                                    <p class="text-[10px] text-slate-400 truncate">@@@user.Username</p>
                                </div>
                            </div>
                        }
                    </div>
                    <button @onclick='() => Navigation.NavigateTo("/users")' class="w-full mt-4 text-center rounded-lg bg-slate-50 text-slate-600 hover:bg-slate-100 py-2 text-xs font-bold transition-all">
                        View all users
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private DashboardSummaryDto summary = new();
    private List<TaskStatusOverviewDto> taskStatuses = new();
    private List<ProjectProgressDto> projectProgress = new();

    private List<TaskDto> taskList = new();
    private List<UserDto> usersList = new();
    private List<ProjectDto> projectsList = new();
    private string currentUserName = "User";
    private string currentUserRole = "Member";
    private List<DateTime> weekDates = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        var client = ApiClient.CreateClient();
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            currentUserName = user.Identity?.Name ?? "User";
            currentUserRole = user.FindFirst(ClaimTypes.Role)?.Value ?? "Member";

            weekDates.Clear();
            var today = DateTime.Today;
            var startOfWeek = today.AddDays(-(int)today.DayOfWeek + (int)DayOfWeek.Monday);
            for (int i = 0; i < 7; i++)
            {
                weekDates.Add(startOfWeek.AddDays(i));
            }

            var summaryResult = await client.GetFromJsonAsync<Result<DashboardSummaryDto>>("Dashboard/summary", Serialization.CaseInsensitive);
            if (summaryResult?.IsSuccess == true && summaryResult.Value != null)
                summary = summaryResult.Value;

            var tasksOverviewResult = await client.GetFromJsonAsync<Result<List<TaskStatusOverviewDto>>>("Dashboard/tasks-overview", Serialization.CaseInsensitive);
            if (tasksOverviewResult?.IsSuccess == true && tasksOverviewResult.Value != null)
                taskStatuses = tasksOverviewResult.Value;

            var progressResult = await client.GetFromJsonAsync<Result<List<ProjectProgressDto>>>("Dashboard/project-progress", Serialization.CaseInsensitive);
            if (progressResult?.IsSuccess == true && progressResult.Value != null)
                projectProgress = progressResult.Value;

            taskList = await client.GetFromJsonAsync<List<TaskDto>>("Task", Serialization.CaseInsensitive) ?? new();
            usersList = await client.GetFromJsonAsync<List<UserDto>>("User", Serialization.CaseInsensitive) ?? new();
            projectsList = await client.GetFromJsonAsync<List<ProjectDto>>("Project", Serialization.CaseInsensitive) ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Dashboard widgets load error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("initIcons");
    }

    private IEnumerable<TaskDto> ActiveTasks => taskList.Where(t => t.StatusId == 2).Take(3);
    private IEnumerable<TaskDto> ChecklistTasks => taskList.Where(t => t.StatusId != 3).Take(4);
    private int ChecklistCompletedCount => taskList.Count(t => t.StatusId == 3);

    private int TotalTasksCount => taskStatuses.Sum(s => s.TaskCount);
    private int CompletedTasksCount => taskStatuses.FirstOrDefault(s => s.StatusId == 3)?.TaskCount ?? 0;
    private int TaskCompletionRate => TotalTasksCount > 0 ? (int)((double)CompletedTasksCount / TotalTasksCount * 100) : 0;
    private int OverdueTasksCount => taskList.Count(t => t.DueDate.Date < DateTime.Today && t.StatusId != 3);

    private IEnumerable<UserDto> GetTeamMembers()
    {
        return usersList.Where(u => !u.Username.Equals(currentUserName, StringComparison.OrdinalIgnoreCase)).Take(3);
    }

    private int GetTaskProgress(long statusId) => statusId switch
    {
        1 => 10,
        2 => 50,
        3 => 100,
        _ => 0
    };

    private List<ChartBar> GetChartBars()
    {
        var today = DateTime.Today;
        var startOfWeek = today.AddDays(-(int)today.DayOfWeek + (int)DayOfWeek.Monday);
        var bars = new List<ChartBar>();

        for (int i = 0; i < 7; i++)
        {
            var day = startOfWeek.AddDays(i);
            var completedCount = taskList.Count(t => t.StatusId == 3 && t.DueDate.Date == day);
            var maxCount = Math.Max(taskList.Count(t => t.StatusId == 3), 1);
            var height = (int)Math.Max(10, (double)completedCount / maxCount * 100);
            bars.Add(new ChartBar(day.ToString("ddd")[..1], height));
        }

        return bars;
    }

    private async Task ToggleTaskStatus(TaskDto task)
    {
        var newStatusId = task.StatusId == 3 ? 1 : 3;
        var client = ApiClient.CreateClient();
        try
        {
            var response = await client.PatchAsync($"Task/{task.Id}/status?statusId={newStatusId}", null);
            if (response.IsSuccessStatusCode)
            {
                task.StatusId = newStatusId;
                await LoadDashboardData();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Toggle task error: {ex.Message}");
        }
    }

    private void NavigateToProjectBoard(long projectId)
    {
        if (projectId > 0)
            Navigation.NavigateTo($"/projects/{projectId}/tasks");
        else
            Navigation.NavigateTo("/board");
    }

    private void NavigateToTask(long taskId)
    {
        Navigation.NavigateTo($"/tasks?taskId={taskId}");
    }

    private record ChartBar(string Day, int Height);
}
