@page "/reports/timesheet"
@using Microsoft.AspNetCore.Authorization
@using TaskTrackingSystem.Shared.Models.Task
@using TaskTrackingSystem.Shared.Models.User
@using TaskTrackingSystem.Shared.Models.Project
@using System.Text
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]
@inject ApiClientService ApiClient
@inject IJSRuntime JS

<PageTitle>Time Tracking &amp; Timesheet Report</PageTitle>

<div class="space-y-6">
    <!-- Page Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h2 class="text-3xl font-bold tracking-tight text-slate-900">Time Tracking &amp; Timesheet</h2>
            <p class="text-slate-500 mt-1">Estimated vs actual hours breakdown by user and project.</p>
        </div>
        <div class="flex items-center space-x-3">
            <div class="inline-flex rounded-lg border border-slate-200 bg-white p-0.5 shadow-sm">
                <button @onclick='() => currentView = "user"'
                        class="inline-flex items-center rounded-md px-3 py-1.5 text-xs font-semibold @(currentView == "user" ? "bg-violet-600 text-white" : "text-slate-600 hover:text-slate-900") transition-colors">
                    <i data-lucide="users" class="h-3.5 w-3.5 mr-1"></i> By User
                </button>
                <button @onclick='() => currentView = "project"'
                        class="inline-flex items-center rounded-md px-3 py-1.5 text-xs font-semibold @(currentView == "project" ? "bg-violet-600 text-white" : "text-slate-600 hover:text-slate-900") transition-colors">
                    <i data-lucide="folder-kanban" class="h-3.5 w-3.5 mr-1"></i> By Project
                </button>
                <button @onclick='() => currentView = "detail"'
                        class="inline-flex items-center rounded-md px-3 py-1.5 text-xs font-semibold @(currentView == "detail" ? "bg-violet-600 text-white" : "text-slate-600 hover:text-slate-900") transition-colors">
                    <i data-lucide="list" class="h-3.5 w-3.5 mr-1"></i> Detail
                </button>
            </div>
            <button @onclick="DownloadCsv" class="inline-flex items-center rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors shadow-sm">
                <i data-lucide="download" class="h-4 w-4 mr-2"></i> Export CSV
            </button>
        </div>
    </div>

    <!-- Summary Cards -->
    @if (!isLoading)
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="rounded-xl border border-violet-100 bg-violet-50 p-5 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-wider text-violet-500">Total Estimated Hrs</p>
                        <p class="mt-1 text-3xl font-bold text-violet-700">@totalEstimated</p>
                    </div>
                    <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-violet-100">
                        <i data-lucide="clock" class="h-6 w-6 text-violet-600"></i>
                    </span>
                </div>
            </div>
            <div class="rounded-xl border border-emerald-100 bg-emerald-50 p-5 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-wider text-emerald-500">Tasks with Hours</p>
                        <p class="mt-1 text-3xl font-bold text-emerald-700">@tasksWithHours</p>
                    </div>
                    <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-100">
                        <i data-lucide="check-circle" class="h-6 w-6 text-emerald-600"></i>
                    </span>
                </div>
            </div>
            <div class="rounded-xl border border-blue-100 bg-blue-50 p-5 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-wider text-blue-500">Avg Hrs / Task</p>
                        <p class="mt-1 text-3xl font-bold text-blue-700">@avgHoursPerTask</p>
                    </div>
                    <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-100">
                        <i data-lucide="bar-chart-2" class="h-6 w-6 text-blue-600"></i>
                    </span>
                </div>
            </div>
            <div class="rounded-xl border border-amber-100 bg-amber-50 p-5 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-wider text-amber-500">Completed Hours</p>
                        <p class="mt-1 text-3xl font-bold text-amber-700">@completedHours</p>
                    </div>
                    <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-amber-100">
                        <i data-lucide="trophy" class="h-6 w-6 text-amber-600"></i>
                    </span>
                </div>
            </div>
        </div>
    }

    <!-- Filters -->
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex flex-wrap items-end gap-4">
            <div class="flex-1 min-w-[200px]">
                <label class="block text-xs font-medium text-slate-500 mb-1.5">Search</label>
                <input @bind="searchInput" type="text" placeholder="Search by user, task, or project..."
                       class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-violet-600 focus:border-transparent transition-all" />
            </div>
            <div>
                <label class="block text-xs font-medium text-slate-500 mb-1.5">Project</label>
                <select @bind="filterProjectId" class="rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-violet-600 focus:border-transparent transition-all">
                    <option value="0">All Projects</option>
                    @foreach (var p in allProjects)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </select>
            </div>
            <div>
                <label class="block text-xs font-medium text-slate-500 mb-1.5">Status</label>
                <select @bind="filterStatusId" class="rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-violet-600 focus:border-transparent transition-all">
                    <option value="0">All</option>
                    <option value="1">To Do</option>
                    <option value="2">In Progress</option>
                    <option value="3">Done</option>
                </select>
            </div>
            <button @onclick="ApplyFilters" class="inline-flex items-center rounded-lg bg-violet-600 px-5 py-2 text-sm font-medium text-white hover:bg-violet-700 transition-colors shadow-sm">
                <i data-lucide="search" class="h-4 w-4 mr-2"></i> Search
            </button>
            <button @onclick="ResetFilters" class="inline-flex items-center rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50 transition-colors shadow-sm">
                <i data-lucide="rotate-ccw" class="h-4 w-4 mr-2"></i> Reset
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <LoadingSpinner Message="Loading timesheet data..." />
    }
    else
    {
        <!-- By User View -->
        @if (currentView == "user")
        {
            <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-slate-100">
                    <h3 class="text-sm font-semibold text-slate-700">Hours Summary by Employee</h3>
                </div>
                <table class="w-full">
                    <thead>
                        <tr class="border-b border-slate-100 bg-slate-50/60">
                            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Employee</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Tasks</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Completed</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Est. Hours</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Completed Hrs</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Completion %</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @{
                            var userGroups = GetFilteredTasks()
                                .GroupBy(t => t.AssignedTo)
                                .OrderByDescending(g => g.Sum(t => t.EstimatedHours ?? 0))
                                .ToList();
                        }
                        @if (userGroups.Any())
                        {
                            @foreach (var group in userGroups)
                            {
                                var user = allUsers.FirstOrDefault(u => u.Id == group.Key);
                                var totalTasks = group.Count();
                                var completedTasks = group.Count(t => t.StatusId == 3);
                                var estHours = group.Sum(t => t.EstimatedHours ?? 0);
                                var compHours = group.Where(t => t.StatusId == 3).Sum(t => t.EstimatedHours ?? 0);
                                var pct = totalTasks > 0 ? (double)completedTasks / totalTasks * 100 : 0;
                                <tr class="hover:bg-slate-50/50 transition-colors">
                                    <td class="px-6 py-4">
                                        @if (user != null)
                                        {
                                            <div class="flex items-center gap-3">
                                                <span class="flex h-9 w-9 items-center justify-center rounded-full bg-violet-100 text-violet-700 text-xs font-bold">
                                                    @(user.FirstName.Length > 0 ? user.FirstName[0].ToString().ToUpper() : "")@(user.LastName.Length > 0 ? user.LastName[0].ToString().ToUpper() : "")
                                                </span>
                                                <div>
                                                    <p class="text-sm font-semibold text-slate-900">@user.FirstName @user.LastName</p>
                                                    <p class="text-xs text-slate-400">@@@user.Username</p>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-sm text-slate-400 italic">Unassigned</span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-sm text-slate-700 font-medium">@totalTasks</td>
                                    <td class="px-6 py-4 text-sm text-emerald-600 font-medium">@completedTasks</td>
                                    <td class="px-6 py-4 text-sm font-semibold text-violet-700">@estHours h</td>
                                    <td class="px-6 py-4 text-sm font-semibold text-amber-600">@compHours h</td>
                                    <td class="px-6 py-4">
                                        <div class="flex items-center gap-3">
                                            <div class="flex-1 h-2 bg-slate-100 rounded-full overflow-hidden">
                                                <div class="h-2 rounded-full @(pct >= 80 ? "bg-emerald-500" : pct >= 50 ? "bg-amber-400" : "bg-rose-400") transition-all"
                                                     style="width: @pct.ToString("F0")%"></div>
                                            </div>
                                            <span class="text-xs font-semibold text-slate-600 w-10">@pct.ToString("F0")%</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <EmptyState ColSpan="6" Icon="clock" Title="No timesheet data" Subtitle="No tasks found with the current filters." />
                        }
                    </tbody>
                </table>
            </div>
        }

        <!-- By Project View -->
        @if (currentView == "project")
        {
            <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-slate-100">
                    <h3 class="text-sm font-semibold text-slate-700">Hours Summary by Project</h3>
                </div>
                <table class="w-full">
                    <thead>
                        <tr class="border-b border-slate-100 bg-slate-50/60">
                            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Project</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Tasks</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Completed</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Est. Hours</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Completed Hrs</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Completion %</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @{
                            var projGroups = GetFilteredTasks()
                                .GroupBy(t => t.ProjectId)
                                .OrderByDescending(g => g.Sum(t => t.EstimatedHours ?? 0))
                                .ToList();
                        }
                        @if (projGroups.Any())
                        {
                            @foreach (var group in projGroups)
                            {
                                var project = allProjects.FirstOrDefault(p => p.Id == group.Key);
                                var totalTasks = group.Count();
                                var completedTasks = group.Count(t => t.StatusId == 3);
                                var estHours = group.Sum(t => t.EstimatedHours ?? 0);
                                var compHours = group.Where(t => t.StatusId == 3).Sum(t => t.EstimatedHours ?? 0);
                                var pct = totalTasks > 0 ? (double)completedTasks / totalTasks * 100 : 0;
                                <tr class="hover:bg-slate-50/50 transition-colors">
                                    <td class="px-6 py-4">
                                        <div class="flex items-center gap-2">
                                            <i data-lucide="folder-kanban" class="h-4 w-4 text-violet-500"></i>
                                            <span class="text-sm font-semibold text-slate-900">@(project?.Name ?? "Unknown Project")</span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-slate-700 font-medium">@totalTasks</td>
                                    <td class="px-6 py-4 text-sm text-emerald-600 font-medium">@completedTasks</td>
                                    <td class="px-6 py-4 text-sm font-semibold text-violet-700">@estHours h</td>
                                    <td class="px-6 py-4 text-sm font-semibold text-amber-600">@compHours h</td>
                                    <td class="px-6 py-4">
                                        <div class="flex items-center gap-3">
                                            <div class="flex-1 h-2 bg-slate-100 rounded-full overflow-hidden">
                                                <div class="h-2 rounded-full @(pct >= 80 ? "bg-emerald-500" : pct >= 50 ? "bg-amber-400" : "bg-rose-400") transition-all"
                                                     style="width: @pct.ToString("F0")%"></div>
                                            </div>
                                            <span class="text-xs font-semibold text-slate-600 w-10">@pct.ToString("F0")%</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <EmptyState ColSpan="6" Icon="folder-kanban" Title="No project data" Subtitle="No tasks found with the current filters." />
                        }
                    </tbody>
                </table>
            </div>
        }

        <!-- Detail View -->
        @if (currentView == "detail")
        {
            <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
                    <h3 class="text-sm font-semibold text-slate-700">
                        Task-level Detail — <span class="text-violet-600">@FilteredDetailTasks.Count() task(s)</span>
                    </h3>
                </div>
                <table class="w-full">
                    <thead>
                        <tr class="border-b border-slate-100 bg-slate-50/60">
                            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Task</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Project</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Assignee</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Est. Hours</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Due Date</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @if (PagedDetailTasks.Any())
                        {
                            @foreach (var task in PagedDetailTasks)
                            {
                                var assignee = allUsers.FirstOrDefault(u => u.Id == task.AssignedTo);
                                var project  = allProjects.FirstOrDefault(p => p.Id == task.ProjectId);
                                var (statusLabel, statusClass) = task.StatusId switch {
                                    2 => ("In Progress", "bg-blue-50 text-blue-700"),
                                    3 => ("Done", "bg-emerald-50 text-emerald-700"),
                                    _ => ("To Do", "bg-slate-100 text-slate-600")
                                };
                                <tr class="hover:bg-slate-50/50 transition-colors">
                                    <td class="px-6 py-4">
                                        <p class="text-sm font-semibold text-slate-900">@task.Title</p>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-slate-600">@(project?.Name ?? "—")</td>
                                    <td class="px-6 py-4">
                                        @if (assignee != null)
                                        {
                                            <div class="flex items-center gap-2">
                                                <span class="flex h-7 w-7 items-center justify-center rounded-full bg-violet-100 text-violet-700 text-xs font-bold">
                                                    @(assignee.FirstName[0..1].ToUpper())@(assignee.LastName[0..1].ToUpper())
                                                </span>
                                                <span class="text-sm text-slate-700">@assignee.FirstName @assignee.LastName</span>
                                            </div>
                                        }
                                        else { <span class="text-xs text-slate-400">Unassigned</span> }
                                    </td>
                                    <td class="px-6 py-4">
                                        @if (task.EstimatedHours.HasValue)
                                        {
                                            <span class="text-sm font-semibold text-violet-700">@task.EstimatedHours h</span>
                                        }
                                        else
                                        {
                                            <span class="text-xs text-slate-400">—</span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-sm text-slate-600">@task.DueDate.ToString("dd-MMM-yyyy")</td>
                                    <td class="px-6 py-4">
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @statusClass">@statusLabel</span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <EmptyState ColSpan="6" Icon="clock" Title="No tasks found" Subtitle="Try adjusting your filters." />
                        }
                    </tbody>
                </table>

                <!-- Pagination -->
                <Pagination CurrentPage="detailPage"
                            TotalPages="DetailTotalPages"
                            PageSize="pageSize"
                            TotalCount="FilteredDetailTasks.Count()"
                            OnPageChanged="HandleDetailPageChanged"
                            OnPageSizeChanged="HandlePageSizeChanged" />
            </div>
        }
    }
</div>

@code {
    private bool isLoading = true;
    private string currentView = "user";

    private List<TaskDto> allTasks = new();
    private List<UserDto> allUsers = new();
    private List<ProjectDto> allProjects = new();

    // Filters
    private string searchInput = "";
    private string appliedSearch = "";
    private long filterProjectId = 0;
    private long appliedProjectId = 0;
    private long filterStatusId = 0;
    private long appliedStatusId = 0;

    // Pagination (detail view)
    private int detailPage = 1;
    private int pageSize = 10;

    // Summary stats
    private int totalEstimated = 0;
    private int tasksWithHours = 0;
    private int avgHoursPerTask = 0;
    private int completedHours = 0;

    private IEnumerable<TaskDto> GetFilteredTasks()
    {
        var result = allTasks.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(appliedSearch))
        {
            var q = appliedSearch.Trim().ToLower();
            result = result.Where(t =>
                t.Title.ToLower().Contains(q) ||
                (allUsers.FirstOrDefault(u => u.Id == t.AssignedTo) is { } usr &&
                 ($"{usr.FirstName} {usr.LastName}").ToLower().Contains(q)) ||
                (allProjects.FirstOrDefault(p => p.Id == t.ProjectId) is { } prj &&
                 prj.Name.ToLower().Contains(q))
            );
        }
        if (appliedProjectId > 0)
            result = result.Where(t => t.ProjectId == appliedProjectId);
        if (appliedStatusId > 0)
            result = result.Where(t => t.StatusId == appliedStatusId);
        return result;
    }

    private IEnumerable<TaskDto> FilteredDetailTasks => GetFilteredTasks().OrderBy(t => t.ProjectId).ThenBy(t => t.Title);
    private int DetailTotalPages => (int)Math.Ceiling((double)FilteredDetailTasks.Count() / pageSize);
    private IEnumerable<TaskDto> PagedDetailTasks => FilteredDetailTasks.Skip((detailPage - 1) * pageSize).Take(pageSize);

    protected override async Task OnInitializedAsync()
    {
        var client = ApiClient.CreateClient();
        try
        {
            var tasksTask    = client.GetFromJsonAsync<List<TaskDto>>("Task", Serialization.CaseInsensitive);
            var usersTask    = client.GetFromJsonAsync<List<UserDto>>("User", Serialization.CaseInsensitive);
            var projectsTask = client.GetFromJsonAsync<List<ProjectDto>>("Project", Serialization.CaseInsensitive);
            await System.Threading.Tasks.Task.WhenAll(tasksTask, usersTask, projectsTask);

            allTasks    = tasksTask.Result    ?? new();
            allUsers    = usersTask.Result    ?? new();
            allProjects = projectsTask.Result ?? new();

            ComputeSummary();
        }
        catch (Exception ex) { Console.WriteLine($"Load error: {ex.Message}"); }
        finally { isLoading = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("initIcons");
    }

    private void ComputeSummary()
    {
        var withHours = allTasks.Where(t => t.EstimatedHours.HasValue).ToList();
        tasksWithHours  = withHours.Count;
        totalEstimated  = withHours.Sum(t => t.EstimatedHours ?? 0);
        avgHoursPerTask = tasksWithHours > 0 ? totalEstimated / tasksWithHours : 0;
        completedHours  = allTasks.Where(t => t.StatusId == 3 && t.EstimatedHours.HasValue).Sum(t => t.EstimatedHours ?? 0);
    }

    private void ApplyFilters()
    {
        appliedSearch    = searchInput;
        appliedProjectId = filterProjectId;
        appliedStatusId  = filterStatusId;
        detailPage = 1;
    }

    private void ResetFilters()
    {
        searchInput = "";      appliedSearch    = "";
        filterProjectId = 0;   appliedProjectId = 0;
        filterStatusId = 0;    appliedStatusId  = 0;
        detailPage = 1;
    }

    private void HandleDetailPageChanged(int page) => detailPage = page;
    private void HandlePageSizeChanged(int size) { pageSize = size; detailPage = 1; }

    private async Task DownloadCsv()
    {
        var sb = new StringBuilder();
        sb.AppendLine("Task Title,Project,Assignee,Estimated Hours,Due Date,Status");
        foreach (var task in GetFilteredTasks())
        {
            var assignee = allUsers.FirstOrDefault(u => u.Id == task.AssignedTo);
            var project  = allProjects.FirstOrDefault(p => p.Id == task.ProjectId);
            var status   = task.StatusId switch { 2 => "In Progress", 3 => "Done", _ => "To Do" };
            sb.AppendLine($"\"{task.Title}\",\"{project?.Name ?? ""}\",\"{(assignee != null ? $"{assignee.FirstName} {assignee.LastName}" : "Unassigned")}\",{task.EstimatedHours?.ToString() ?? ""},\"{task.DueDate:dd-MMM-yyyy}\",{status}");
        }
        var bytes  = Encoding.UTF8.GetBytes(sb.ToString());
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("downloadFile", $"timesheet_{DateTime.Today:yyyy-MM-dd}.csv", "text/csv", base64);
    }
}
